{
  "name": "folio-reader",
  "version": "1.0.0",
  "description": "A quiet place to read Markdown. Local, offline desktop reader.",
  "license": "MIT",
  "author": "Arav Madan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aravmdn/folio.git"
  },
  "homepage": "https://github.com/aravmdn/folio#readme",
  "bugs": "https://github.com/aravmdn/folio/issues",
  "keywords": [
    "markdown",
    "reader",
    "electron",
    "desktop",
    "offline"
  ],
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "npm run build && electron .",
    "dev": "vite --host 127.0.0.1",
    "install-local": "npm run build && node scripts/install-local.mjs",
    "uninstall-local": "node scripts/uninstall-local.mjs",
    "pretest": "npm run build",
    "test": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lucide": "^1.43.0",
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.2"
  }
}
